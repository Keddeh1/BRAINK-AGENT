{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keddeh:braink-agent:sector:v1",
  "title": "Source-attributed market bottleneck record",
  "type": "object",
  "required": ["id", "title", "bottleneck", "sources", "deliveryPurpose", "analystPurpose", "foundryRefs"],
  "properties": {
    "id": {"type":"string","pattern":"^[A-Za-z0-9_-]{1,60}$"},
    "title": {"type":"string","minLength":1},
    "bottleneck": {"type":"string","minLength":1},
    "sources": {"type":"array","minItems":1,"maxItems":32,"items":{"type":"object","required":["url","title","claim","accessed"],"properties":{"url":{"type":"string","pattern":"^https://"},"title":{"type":"string","minLength":1},"claim":{"type":"string","minLength":1},"accessed":{"type":"string","minLength":1}}}},
    "deliveryPurpose":{"type":"string","minLength":1},
    "analystPurpose":{"type":"string","minLength":1},
    "foundryRefs":{"type":"array","items":{"type":"string"}},
    "technicalSectorRefs":{"type":"array","items":{"type":"string"}},
    "applicationSectorRefs":{"type":"array","items":{"type":"string"}},
    "functionRefs":{"type":"array","items":{"type":"string"}}
  }
}
